# Copy to .env (gitignored).
OPENAI_API_KEY=
# Any Responses API model with structured outputs and function calling.
OPENAI_MODEL=gpt-5.5
# Optional, reasoning models only: minimal | low | medium | high
OPENAI_REASONING_EFFORT=

# The worker passes the S3 location of each upload; credentials come from the
# default AWS provider chain.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
