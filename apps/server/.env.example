# Copy to .env (gitignored). Bun loads it automatically.
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Local Postgres from compose.yaml (bun run db:up).
DATABASE_URL=postgres://kuki:kuki@localhost:5432/kuki

AWS_REGION=ap-south-1
AWS_S3_BUCKET=kuki-evidence-documents-dev-ap-south-1
AWS_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/kuki-document-extraction-dev
# Or use a shared profile / IAM role instead of keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The Python AI service (apps/ai).
AI_SERVICE_URL=http://localhost:8000
