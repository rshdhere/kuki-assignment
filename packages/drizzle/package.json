{
  "name": "@kuki/drizzle",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/seed.ts"
  },
  "devDependencies": {
    "@kuki/eslint-config": "workspace:*",
    "@kuki/typescript-config": "workspace:*",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@kuki/config": "workspace:*",
    "@kuki/types": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  }
}
