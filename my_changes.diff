+  color: var(--text-2);
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+}
+
+/* A list of plain rows inside a card: documents, earlier questions. */
+.rows {
+  display: flex;
+  flex-direction: column;
+}
+.rows > * {
+  all: unset;
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  padding: 10px 12px;
+  border-radius: var(--r-sm);
+  cursor: pointer;
+  transition: background-color var(--d1) var(--ease-out);
+}
+.rows > *:hover,
+.rows > [aria-current="true"] {
+  background: var(--shelf);
+}
+.rows > *:focus-visible {
+  outline: 2px solid var(--ink);
+}
+.rows .row-title {
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--ink);
+}
+.rows .row-sub {
+  font-size: 12px;
+  color: var(--muted);
+}
+
+/* Three plain steps, shown before anything is uploaded. */
+.steps {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 16px;
+}
+@media (max-width: 760px) {
+  .steps {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+.step-n {
+  width: 24px;
+  height: 24px;
+  display: grid;
+  place-items: center;
+  border-radius: 999px;
+  background: var(--wash);
+  font: 600 12px var(--font);
+}
+
+.chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+.chip {
+  all: unset;
+  box-sizing: border-box;
+  padding: 7px 12px;
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  background: var(--paper);
+  font-size: 13px;
+  color: var(--ink);
+  cursor: pointer;
+  transition:
+    background-color var(--d1) var(--ease-out),
+    border-color var(--d1) var(--ease-out);
+}
+.chip:hover {
+  background: var(--shelf);
+  border-color: var(--line-2);
+}
+.chip:focus-visible {
+  outline: 2px solid var(--ink);
+}
+
+.check-row {
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+  font-size: 13px;
+}
+.check-row label {
+  overflow-wrap: anywhere;
+}
+
+/* Shell on narrow screens: the sidebar becomes a drawer opened from the top bar. */
+@media (max-width: 900px) {
+  .page {
+    padding: 20px 16px;
+    gap: 20px;
+  }
+  .topbar {
+    padding: 10px 16px;
+  }
+  .side {
+    position: fixed;
+    inset: 0 auto 0 0;
+    z-index: 60;
+    transform: translateX(-100%);
+    transition: transform var(--d3) var(--ease-out);
+    box-shadow: var(--shadow-3);
+  }
+  .sidebar-collapsed .side {
+    display: flex;
+  }
+  .sidebar-open .side {
+    transform: none;
+  }
+  .sidebar-open .side-backdrop {
+    display: block;
+    position: fixed;
+    inset: 0;
+    z-index: 50;
+    border: 0;
+    background: rgba(16, 36, 28, 0.4);
+  }
+}
+
+/* Summary cards sit two by two on phones instead of one long column. */
+@media (max-width: 560px) {
+  .grid-stats {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 12px;
+  }
+  .grid-stats .stat {
+    font-size: 24px;
+  }
+}
