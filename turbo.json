{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "AWS_*",
        "CLIENT_ORIGIN",
        "DATABASE_URL",
        "RESEND_API_KEY",
        "TEST_DATABASE_URL"
      ]
    },
    "test:e2e": {
      "env": ["CI", "E2E_PORT"],
      "cache": false
    },
    "dev": {
      "env": [
        "AI_SERVICE_URL",
        "AI_TIMEOUT_MS",
        "AWS_*",
        "CLIENT_ORIGIN",
        "DATABASE_URL",
        "OPENAI_*",
        "PORT",
        "RESEND_API_KEY",
        "WORKER_CONCURRENCY"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
